#define __CCE_KT_TEST__

#include <iostream>
#include <vector>
#include <cmath>
#include <cstring>
#include <algorithm>
#include "acl/acl.h"
#include "op_kernel/adaptive_avg_pool2d_grad_tiling.h"
#include "op_kernel/adaptive_avg_pool2d_grad.cpp"

static void checkAcl(aclError code, const char* msg) {
    if (code != ACL_SUCCESS) {
        std::cerr << "ACL Error: " << msg << ", code=" << code << std::endl;
        exit(1);
    }
}

// CPU 黄金参考实现
static void cpu_golden(const float* grad_out, float* grad_in, uint32_t N, uint32_t C, uint32_t H, uint32_t W, uint32_t H_out, uint32_t W_out) {
    uint32_t total_out = N * C * H * W;
    for (uint32_t i = 0; i < total_out; ++i) grad_in[i] = 0.0f;
    uint64_t HW = (uint64_t)H * W;

    for (uint32_t idx = 0; idx < total_out; ++idx) {
        uint32_t c = (uint32_t)(idx / HW);
        uint64_t rem = idx % HW;
        uint32_t h = (uint32_t)(rem / W);
        uint32_t w = (uint32_t)(rem % W);

        uint32_t oh_start = (uint32_t)(((uint64_t)h * H_out) / H);
        uint32_t oh_end = (uint32_t)(((uint64_t)(h + 1) * H_out + H - 1) / H);
        uint32_t ow_start = (uint32_t)(((uint64_t)w * W_out) / W);
        uint32_t ow_end = (uint32_t)(((uint64_t)(w + 1) * W_out + W - 1) / W);

        float sum_val = 0.0f;
        for (uint32_t i = oh_start; i < oh_end; ++i) {
            int32_t hs = (int32_t)(((int64_t)i * H) / H_out);
            int32_t he = (int32_t)(((int64_t)(i + 1) * H + H_out - 1) / H_out);
            int32_t win_h = he - hs;
            float inv_h = 1.0f / (float)win_h;

            for (uint32_t j = ow_start; j < ow_end; ++j) {
                int32_t ws = (int32_t)(((int64_t)j * W) / W_out);
                int32_t we = (int32_t)(((int64_t)(j + 1) * W + W_out - 1) / W_out);
                int32_t win_w = we - ws;
                float inv_w = 1.0f / (float)win_w;

                uint32_t in_offset = c * (H_out * W_out) + i * W_out + j;
                sum_val += grad_out[in_offset] * (inv_h * inv_w);
            }
        }
        grad_in[idx] = sum_val;
    }
}

int main(int argc, char** argv) {
    std::cout << "[TestRunner] 正在初始化昇腾硬件环境..." << std::endl;
    checkAcl(aclInit(nullptr), "aclInit");
    int deviceId = 0;
    checkAcl(aclrtSetDevice(deviceId), "aclrtSetDevice");
    aclrtStream stream = nullptr;
    checkAcl(aclrtCreateStream(&stream), "aclrtCreateStream");

    int64_t coreNum = 8;
    aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreNum);
    if (coreNum <= 0) coreNum = 8;

    // 测试维度: N=1, C=1, H_in=4, W_in=4, H_out=2, W_out=2
    uint32_t N = 1, C = 1, Hin = 4, Win = 4, Hout = 2, Wout = 2;
    uint32_t inElems = N * C * Hout * Wout;
    uint32_t outElems = N * C * Hin * Win;

    std::vector<float> hostGradOutput = {1.0f, 2.0f, 3.0f, 4.0f};
    std::vector<float> hostGradInput(outElems, 0.0f);
    std::vector<float> hostGolden(outElems, 0.0f);

    cpu_golden(hostGradOutput.data(), hostGolden.data(), N, C, Hin, Win, Hout, Wout);

    // 保证至少分配 64 字节以满足 32 字节对齐
    size_t inBytes = std::max<size_t>(inElems * sizeof(float), 64);
    size_t outBytes = std::max<size_t>(outElems * sizeof(float), 64);
    size_t tilingBytes = std::max<size_t>(sizeof(AdaptiveAvgPool2dGradTilingData), 64);

    void *devGradOutput = nullptr, *devGradInput = nullptr, *devTiling = nullptr;
    checkAcl(aclrtMalloc(&devGradOutput, inBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc in");
    checkAcl(aclrtMalloc(&devGradInput, outBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc out");
    checkAcl(aclrtMalloc(&devTiling, tilingBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc tiling");

    checkAcl(aclrtMemset(devGradInput, outBytes, 0, outBytes), "memset out");
    checkAcl(aclrtMemcpy(devGradOutput, inElems * sizeof(float), hostGradOutput.data(), inElems * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE), "memcpy in");

    // 切分参数构造
    AdaptiveAvgPool2dGradTilingData tiling;
    const uint32_t ALIGN = 8;
    uint32_t totalBlocks = (outElems + ALIGN - 1) / ALIGN;
    uint32_t blockDim = totalBlocks < (uint32_t)coreNum ? totalBlocks : (uint32_t)coreNum;
    if (blockDim == 0) blockDim = 1;

    tiling.totalTaskNum = totalBlocks;
    tiling.tasksPerCore = totalBlocks / blockDim;
    tiling.extraTasks = totalBlocks % blockDim;
    tiling.alignBlockSize = ALIGN;
    tiling.N = N;
    tiling.C = C;
    tiling.H_in = Hin;
    tiling.W_in = Win;
    tiling.H_out = Hout;
    tiling.W_out = Wout;
    tiling.totalGradInputSize = outElems;
    tiling.totalGradOutputSize = inElems;

    checkAcl(aclrtMemcpy(devTiling, sizeof(tiling), &tiling, sizeof(tiling), ACL_MEMCPY_HOST_TO_DEVICE), "memcpy tiling");

    std::cout << "[TestRunner] 正在启动 Kernel: blockDim=" << blockDim << " ..." << std::endl;
    adaptive_avg_pool2d_grad<<<blockDim, nullptr, stream>>>(
        (GM_ADDR)devGradOutput,
        (GM_ADDR)devGradInput,
        nullptr,
        (GM_ADDR)devTiling
    );

    checkAcl(aclrtSynchronizeStream(stream), "sync stream");
    checkAcl(aclrtMemcpy(hostGradInput.data(), outElems * sizeof(float), devGradInput, outElems * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST), "memcpy out");

    // 精度校验
    int mismatch = 0;
    for (uint32_t i = 0; i < outElems; ++i) {
        float diff = std::abs(hostGradInput[i] - hostGolden[i]);
        if (diff > 1e-4) {
            mismatch++;
        }
    }

    std::cout << "----------------------------------------------------------" << std::endl;
    std::cout << "比对结果: mismatched=" << mismatch << "/" << outElems << std::endl;
    if (mismatch == 0) {
        std::cout << "PASSED" << std::endl;
    } else {
        std::cout << "FAILED" << std::endl;
    }
    std::cout << "----------------------------------------------------------" << std::endl;

    aclrtFree(devGradOutput);
    aclrtFree(devGradInput);
    aclrtFree(devTiling);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return mismatch == 0 ? 0 : 1;
}
